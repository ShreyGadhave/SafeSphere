# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase (Project Settings -> API / Database). The service-role key bypasses RLS:
# keep it on the server only, never in the mobile app or admin dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Groq free tier. Models are tried in order; each has its own quota.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant,openai/gpt-oss-120b,llama-3.3-70b-versatile
GROQ_REQUESTS_PER_MINUTE=25
GROQ_TIMEOUT_S=20

# Comma-separated origins allowed to call this API (admin dashboard dev server).
ALLOWED_ORIGINS=http://localhost:5173

# Trained model artifacts (defaults to ../../ml/models).
# MODEL_DIR=D:\Major Project\safesphere\ml\models
