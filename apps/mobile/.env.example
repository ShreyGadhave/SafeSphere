# Copy to .env (gitignored) and fill in. Everything here ships inside the APK,
# so only PUBLIC values belong here — never the Supabase service_role key.

# Supabase → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API → anon / publishable key
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# FastAPI ML service (services/ml-api). Use your PC's LAN IP during development,
# e.g. http://192.168.1.20:8000 — the phone can't reach "localhost" on your PC.
EXPO_PUBLIC_ML_API_URL=http://192.168.1.20:8000

# Public URL of the deployed admin web app (serves /live/<token> share pages).
# Leave empty until deployed — SMS then include a plain map link instead.
EXPO_PUBLIC_SHARE_BASE_URL=
